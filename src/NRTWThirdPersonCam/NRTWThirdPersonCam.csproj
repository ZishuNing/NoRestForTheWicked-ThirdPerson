<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>NRTWThirdPersonCam</AssemblyName>
    <RootNamespace>NRTWThirdPersonCam</RootNamespace>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0618;CS8632</NoWarn>
    <Version>1.1.0</Version>
    <Description>Third-person camera tweaks for No Rest for the Wicked (BepInEx IL2CPP plugin)</Description>
    <GameDir Condition="'$(GameDir)'==''">$(NRTW_GAME_DIR)</GameDir>
  </PropertyGroup>

  <Target Name="RequireGameDir" BeforeTargets="ResolveReferences"
          Condition="'$(GameDir)'=='' or !Exists('$(GameDir)\BepInEx\core')">
    <Error Text="GameDir is not set or invalid. Set the NRTW_GAME_DIR environment variable (or pass /p:GameDir=...) to the game root folder containing BepInEx\core and BepInEx\interop." />
  </Target>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\*.dll" />
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" />
  </ItemGroup>

</Project>
